<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8">
    <title><%= @document.display_name %></title>
    <style>
      body {
        color: #1f2933;
        font-family: "Helvetica Neue", Arial, sans-serif;
        font-size: 12px;
        line-height: 1.6;
        margin: 0;
      }

      .document-pdf {
        padding: 16px 28px 24px;
      }

      .document-pdf__header {
        display: table;
        margin-bottom: 24px;
        width: 100%;
      }

      .document-pdf__header > div {
        display: table-cell;
        vertical-align: top;
        width: 50%;
      }

      .document-pdf__header h1 {
        color: #2c3e50;
        font-size: 24px;
        margin: 0 0 8px;
      }

      .document-pdf__eyebrow {
        color: #8b6b16;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 0.08em;
        margin-bottom: 8px;
        text-transform: uppercase;
      }

      .document-pdf__header p {
        margin: 0 0 4px;
      }

      .document-pdf__meta {
        text-align: right;
      }

      .document-pdf__body h1,
      .document-pdf__body h2,
      .document-pdf__body h3,
      .document-pdf__body h4 {
        color: #2c3e50;
        margin: 18px 0 10px;
      }

      .document-pdf__body p,
      .document-pdf__body li,
      .document-pdf__body blockquote {
        margin: 0 0 10px;
      }

      .document-pdf__body table {
        border-collapse: collapse;
        margin: 12px 0;
        width: 100%;
      }

      .document-pdf__body th,
      .document-pdf__body td {
        border: 1px solid #d9dee3;
        padding: 8px;
        text-align: left;
      }

      .document-pdf__body {
        min-height: 640px;
      }
    </style>
  </head>

  <body>
    <%= yield %>
  </body>
</html>