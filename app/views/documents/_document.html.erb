<div id="<%= dom_id document %>">
  <div>
    <strong>Property:</strong>
    <%= document.property_id %>
  </div>

  <div>
    <strong>Occupant:</strong>
    <%= document.occupant_id %>
  </div>

  <div>
    <strong>Name:</strong>
    <%= document.name %>
  </div>

  <div>
    <strong>Body:</strong>
    <%= document.body %>
  </div>

  <div>
    <strong>Status:</strong>
    <%= document.status %>
  </div>

  <div>
    <strong>Start date:</strong>
    <%= document.start_date %>
  </div>

  <div>
    <strong>End date:</strong>
    <%= document.end_date %>
  </div>

  <div>
    <strong>Metadata:</strong>
    <%= document.metadata %>
  </div>

</div>
