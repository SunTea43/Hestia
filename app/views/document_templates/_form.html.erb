<div class="card border-0 shadow-sm rounded-4 p-4">
  <%= form_with(model: document_template) do |form| %>
    <% if document_template.errors.any? %>
      <div class="alert alert-danger rounded-3 border-0">
        <h6 class="fw-bold"><%= pluralize(document_template.errors.count, "error") %> impidieron guardar:</h6>
        <ul class="mb-0 small">
          <% document_template.errors.each do |error| %>
            <li><%= error.full_message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="row g-3">
      <div class="col-md-6">
        <%= form.label :name, "Nombre de la Plantilla", class: "form-label fw-bold" %>
        <%= form.text_field :name, class: "form-control rounded-3", placeholder: "Ej: Contrato de Arrendamiento" %>
      </div>

      <div class="col-md-6">
        <%= form.label :parent_id, "Carpeta Padre (Opcional)", class: "form-label fw-bold" %>
        <%= form.collection_select :parent_id, DocumentTemplate.root, :id, :name, { prompt: "Sin carpeta padre (raíz)" }, { class: "form-select rounded-3" } %>
      </div>

      <div class="col-12">
        <%= form.label :description, "Descripción", class: "form-label fw-bold" %>
        <%= form.text_area :description, rows: 3, class: "form-control rounded-3", placeholder: "Descripción breve del propósito de esta plantilla..." %>
      </div>

      <div class="col-12">
        <%= form.label :body, "Contenido de la Plantilla", class: "form-label fw-bold" %>
        <%= form.text_area :body, class: "tinymce rounded-3", rows: 15, placeholder: "Escribe el contenido de la plantilla aquí..." %>
      </div>

      <div class="col-12 mt-4">
        <div class="d-flex gap-2">
          <%= form.submit "Guardar Plantilla", class: "btn btn-hestia px-4 py-2 rounded-3 shadow-sm" %>
          <%= link_to "Cancelar", document_templates_path, class: "btn btn-light px-4 py-2 rounded-3" %>
        </div>
      </div>
    </div>
  <% end %>
</div>

<script>
  tinymce.init({
    selector: '.tinymce',
    height: 400,
    menubar: true,
    plugins: [
      'advlist', 'autolink', 'lists', 'link', 'image', 'charmap', 'preview',
      'anchor', 'searchreplace', 'visualblocks', 'fullscreen',
      'insertdatetime', 'media', 'table', 'help', 'wordcount'
    ],
    toolbar: 'undo redo | blocks | ' +
      'bold italic backcolor | alignleft aligncenter ' +
      'alignright alignjustify | bullist numlist outdent indent | ' +
      'insertTenant insertProperty insertContract insertOwner insertCompany | ' +
      'removeformat | help',
    setup: function(editor) {
      const translations = {
        tenant: {
          label: '<%= j(t("document_variables.tenant.label")) %>',
          full_name: '<%= j(t("document_variables.tenant.full_name")) %>',
          document_number: '<%= j(t("document_variables.tenant.document_number")) %>',
          email: '<%= j(t("document_variables.tenant.email")) %>',
          phone: '<%= j(t("document_variables.tenant.phone")) %>'
        },
        property: {
          label: '<%= j(t("document_variables.property.label")) %>',
          address: '<%= j(t("document_variables.property.address")) %>',
          area: '<%= j(t("document_variables.property.area")) %>',
          rent_price: '<%= j(t("document_variables.property.rent_price")) %>',
          type: '<%= j(t("document_variables.property.type")) %>'
        },
        contract: {
          label: '<%= j(t("document_variables.contract.label")) %>',
          start_date: '<%= j(t("document_variables.contract.start_date")) %>',
          end_date: '<%= j(t("document_variables.contract.end_date")) %>',
          deposit_amount: '<%= j(t("document_variables.contract.deposit_amount")) %>',
          rent_amount: '<%= j(t("document_variables.contract.rent_amount")) %>'
        },
        owner: {
          label: '<%= j(t("document_variables.owner.label")) %>',
          full_name: '<%= j(t("document_variables.owner.full_name")) %>',
          nit: '<%= j(t("document_variables.owner.nit")) %>',
          address: '<%= j(t("document_variables.owner.address")) %>'
        },
        company: {
          label: '<%= j(t("document_variables.company.label")) %>',
          name: '<%= j(t("document_variables.company.name")) %>',
          nit: '<%= j(t("document_variables.company.nit")) %>',
          address: '<%= j(t("document_variables.company.address")) %>'
        }
      };

      editor.ui.registry.addButton('insertTenant', {
        text: translations.tenant.label,
        icon: 'user',
        onAction: function() {
          const menu = [
            { text: translations.tenant.full_name, value: '{{tenant.full_name}}' },
            { text: translations.tenant.document_number, value: '{{tenant.document_number}}' },
            { text: translations.tenant.email, value: '{{tenant.email}}' },
            { text: translations.tenant.phone, value: '{{tenant.phone}}' }
          ];
          showVariableMenu(editor, menu);
        }
      });

      editor.ui.registry.addButton('insertProperty', {
        text: translations.property.label,
        icon: 'home',
        onAction: function() {
          const menu = [
            { text: translations.property.address, value: '{{property.address}}' },
            { text: translations.property.area, value: '{{property.area}}' },
            { text: translations.property.rent_price, value: '{{property.rent_price}}' },
            { text: translations.property.type, value: '{{property.type}}' }
          ];
          showVariableMenu(editor, menu);
        }
      });

      editor.ui.registry.addButton('insertContract', {
        text: translations.contract.label,
        icon: 'file',
        onAction: function() {
          const menu = [
            { text: translations.contract.start_date, value: '{{contract.start_date}}' },
            { text: translations.contract.end_date, value: '{{contract.end_date}}' },
            { text: translations.contract.deposit_amount, value: '{{contract.deposit_amount}}' },
            { text: translations.contract.rent_amount, value: '{{contract.rent_amount}}' }
          ];
          showVariableMenu(editor, menu);
        }
      });

      editor.ui.registry.addButton('insertOwner', {
        text: translations.owner.label,
        icon: 'users',
        onAction: function() {
          const menu = [
            { text: translations.owner.full_name, value: '{{owner.full_name}}' },
            { text: translations.owner.nit, value: '{{owner.nit}}' },
            { text: translations.owner.address, value: '{{owner.address}}' }
          ];
          showVariableMenu(editor, menu);
        }
      });

      editor.ui.registry.addButton('insertCompany', {
        text: translations.company.label,
        icon: 'building',
        onAction: function() {
          const menu = [
            { text: translations.company.name, value: '{{company.name}}' },
            { text: translations.company.nit, value: '{{company.nit}}' },
            { text: translations.company.address, value: '{{company.address}}' }
          ];
          showVariableMenu(editor, menu);
        }
      });
    },
    content_style: 'body { font-family:Inter,sans-serif; font-size:14px }'
  });

  function showVariableMenu(editor, menu) {
    editor.windowManager.open({
      title: 'Seleccionar Variable',
      body: {
        type: 'panel',
        items: menu.map(item => ({
          type: 'button',
          text: item.text,
          name: item.value,
          onclick: function() {
            editor.insertContent(item.value);
            editor.windowManager.close();
          }
        }))
      },
      buttons: [
        {
          text: 'Cerrar',
          type: 'cancel',
          onclick: 'close'
        }
      ]
    });
  }
</script>
