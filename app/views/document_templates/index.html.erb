<div class="d-flex justify-content-between align-items-center mb-4 pt-3">
  <div>
    <h1 class="fw-bold mb-0 text-dark">Plantillas de Documentos</h1>
    <p class="text-muted">Gestión de plantillas para generación de documentos</p>
  </div>
  <div class="d-flex gap-2">
    <%= link_to new_document_template_path, class: "btn btn-hestia d-flex align-items-center gap-2 px-4 py-2 rounded-3 shadow-sm" do %>
      <%= lucide_icon "plus-circle", size: 20 %>
      Nueva Plantilla
    <% end %>
  </div>
</div>

<div class="card border-0 shadow-sm rounded-4 overflow-hidden">
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
      <thead class="bg-light">
        <tr>
          <th class="px-4 py-3">Nombre</th>
          <th class="py-3">Descripción</th>
          <th class="py-3">Carpetas Hijas</th>
          <th class="py-3">Documentos</th>
          <th class="py-3 text-end px-4">Acciones</th>
        </tr>
      </thead>
      <tbody>
        <% @document_templates.each do |template| %>
          <tr>
            <td class="px-4">
              <div class="d-flex align-items-center gap-2">
                <div class="bg-hestia-gold bg-opacity-10 p-2 rounded-3" style="background-color: rgba(212, 175, 55, 0.1)">
                  <%= lucide_icon "file-text", size: 18, class: "text-hestia-gold" %>
                </div>
                <div>
                  <div class="fw-bold text-dark"><%= template.name %></div>
                  <% if template.parent %>
                    <small class="text-muted">En: <%= template.parent.name %></small>
                  <% end %>
                </div>
              </div>
            </td>
            <td>
              <div class="text-muted small"><%= template.description&.truncate(100) || 'Sin descripción' %></div>
            </td>
            <td>
              <span class="badge bg-info bg-opacity-10 text-info rounded-pill px-3 py-1">
                <%= template.children.count %> carpetas
              </span>
            </td>
            <td>
              <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-1">
                <%= template.documents.count %> documentos
              </span>
            </td>
            <td class="text-end px-4">
              <div class="btn-group">
                <%= link_to document_template_path(template), class: "btn btn-outline-primary btn-sm rounded-3 p-2", title: "Ver" do %>
                  <%= lucide_icon "eye", size: 18 %>
                <% end %>
                <%= link_to edit_document_template_path(template), class: "btn btn-outline-warning btn-sm rounded-3 p-2 mx-1", title: "Editar" do %>
                  <%= lucide_icon "edit-3", size: 18 %>
                <% end %>
                <%= button_to document_template_path(template), method: :delete, 
                    class: "btn btn-outline-danger btn-sm rounded-3 p-2 mx-1", 
                    title: "Eliminar",
                    form: { data: { turbo_confirm: "¿Estás seguro de eliminar esta plantilla?" } } do %>
                  <%= lucide_icon "trash-2", size: 18 %>
                <% end %>
                <%= link_to new_document_template_path(parent_id: template.id), 
                    class: "btn btn-outline-secondary btn-sm rounded-3 p-2", 
                    title: "Agregar subcarpeta" do %>
                  <%= lucide_icon "folder-plus", size: 18 %>
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
        <% if @document_templates.empty? %>
          <tr>
            <td colspan="5" class="text-center py-5 text-muted">
              No hay plantillas de documentos registradas.
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
