<div class="d-flex justify-content-between align-items-center mb-4 pt-3">
  <div>
    <h1 class="fw-bold mb-0 text-dark"><%= @document_type.name %></h1>
    <p class="text-muted mb-0">Configuracion del tipo de documento</p>
  </div>

  <div class="d-flex gap-2">
    <%= link_to edit_document_type_path(@document_type), class: "btn btn-hestia d-flex align-items-center gap-2 px-4 py-2 rounded-3 shadow-sm" do %>
      <%= lucide_icon "edit-3", size: 18 %>
      Editar
    <% end %>

    <%= link_to document_types_path, class: "btn btn-outline-secondary d-flex align-items-center gap-2 px-4 py-2 rounded-3 shadow-sm" do %>
      <%= lucide_icon "arrow-left", size: 18 %>
      Volver
    <% end %>
  </div>
</div>

<div class="card border-0 shadow-sm rounded-4 p-4">
  <div class="row g-4">
    <div class="col-md-8">
      <div class="d-flex align-items-center gap-3 mb-4">
        <div class="p-3 rounded-4" style="background-color: <%= @document_type.color %>22; color: <%= @document_type.color %>;">
          <%= lucide_icon (@document_type.icon || "file-text"), size: 28 %>
        </div>
        <div>
          <div class="fw-bold fs-5 text-dark"><%= @document_type.name %></div>
          <span class="badge <%= @document_type.html_template? ? 'bg-primary-subtle text-primary' : 'bg-secondary-subtle text-secondary' %> rounded-pill px-3 py-2 mt-2">
            <%= @document_type.html_template? ? 'HTML generado desde plantilla' : 'Adjunto cargado manualmente' %>
          </span>
        </div>
      </div>

      <div>
        <small class="text-muted fw-bold">Descripcion</small>
        <div class="text-dark mt-1"><%= @document_type.description.presence || 'Sin descripcion' %></div>
      </div>
    </div>

    <div class="col-md-4">
      <div class="mb-3">
        <small class="text-muted fw-bold">Icono</small>
        <div class="text-dark"><%= @document_type.icon.presence || 'file-text' %></div>
      </div>

      <div class="mb-3">
        <small class="text-muted fw-bold">Color</small>
        <div class="d-flex align-items-center gap-2 mt-1">
          <span class="rounded-circle border" style="display:inline-block; width: 18px; height: 18px; background-color: <%= @document_type.color %>;"></span>
          <span class="text-dark"><%= @document_type.color %></span>
        </div>
      </div>
    </div>
  </div>
</div>
