<div class="d-flex justify-content-between align-items-center mb-4 pt-3">
  <div>
    <h1 class="fw-bold mb-0 text-dark">Tipos de Documento</h1>
    <p class="text-muted">Define categorías y configuraciones para tus documentos</p>
  </div>
  <%= link_to new_document_type_path, class: "btn btn-hestia d-flex align-items-center gap-2 px-4 py-2 rounded-3 shadow-sm" do %>
    <%= lucide_icon "plus-circle", size: 20 %>
    Nuevo Tipo
  <% end %>
</div>

<div class="row g-4">
  <% @document_types.each do |document_type| %>
    <div class="col-md-4">
      <div class="card border-0 shadow-sm rounded-4 h-100 overflow-hidden">
        <div class="card-body p-4">
          <div class="d-flex align-items-center gap-3 mb-3">
            <div class="p-3 rounded-4" style="background-color: <%= document_type.color %>22; color: <%= document_type.color %>;">
              <%= lucide_icon (document_type.icon || "file-text"), size: 24 %>
            </div>
            <h5 class="fw-bold mb-0 text-dark"><%= document_type.name %></h5>
          </div>
          <p class="text-muted small mb-4"><%= document_type.description %></p>

          <div class="d-flex justify-content-between align-items-center mt-auto">
            <div class="d-flex gap-2">
              <%= link_to edit_document_type_path(document_type), class: "btn btn-light btn-sm rounded-3 p-2", title: "Editar" do %>
                <%= lucide_icon "edit-3", size: 16 %>
              <% end %>
              <%= button_to document_type, method: :delete, data: { confirm: "¿Estás seguro?" }, class: "btn btn-light btn-sm rounded-3 p-2 text-danger", title: "Eliminar" do %>
                <%= lucide_icon "trash-2", size: 16 %>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    </div>
  <% end %>
</div>
