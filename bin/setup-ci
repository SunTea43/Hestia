#!/bin/bash
# Script para CI/CD - Evitar frozen mode error en bundle install

# Este script se ejecuta ANTES de bundle install en el pipeline
# Desactiva frozen mode temporalmente para actualizar Gemfile.lock

echo "🔓 Desactivando frozen mode para CI/CD..."
bundle config set frozen false

echo "📦 Instalando dependencias..."
bundle install

echo "🔒 Re-activando frozen mode..."
bundle config set frozen true

echo "✅ Listo para ejecutar tests y linting"
